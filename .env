APP_NAME=reciclapp-image-verification-demo
APP_ENV=development
MAX_IMAGE_SIZE_MB=5
MIN_IMAGE_WIDTH=300
MIN_IMAGE_HEIGHT=300
IMAGE_MODEL_PATH=app/models/recyclable_model.keras
IMAGE_INPUT_WIDTH=224
IMAGE_INPUT_HEIGHT=224
BLUR_THRESHOLD=80
BRIGHTNESS_THRESHOLD=50
CLASSIFICATION_APPROVAL_THRESHOLD=0.80
CLASSIFICATION_REVIEW_THRESHOLD=0.50

GOOGLE_APPLICATION_CREDENTIALS=false
USE_GOOGLE_SAFESEARCH=false

CLASSIFIER_DEMO_MODE=true
INPUT_IMAGES_DIR=input_images
OUTPUT_REPORTS_DIR=output_reports
LOG_LEVEL=INFO
